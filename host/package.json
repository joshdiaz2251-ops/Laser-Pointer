{
  "name": "laser-pointer-host",
  "version": "1.0.0",
  "private": true,
  "description": "Runs on your friend's PC. Shares the screen and shows a transparent overlay dot driven by your mouse.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.laserpointer.host",
    "productName": "LaserPointerHost",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "control.html",
      "overlay.html",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
